<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CleanSnap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CleanSnap.Views"
    Title="CleanSnap">

    <TabBar>
        <Tab Title="Dashboard" Icon="dotnet_bot.png">
            <ShellContent
                Title="Dashboard"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>

        <Tab Title="Deep Scan" Icon="dotnet_bot.png">
            <ShellContent
                Title="Deep Scan"
                ContentTemplate="{DataTemplate views:ScanPage}"
                Route="ScanPage" />
        </Tab>

        <Tab Title="Review" Icon="dotnet_bot.png">
            <ShellContent
                Title="Review"
                ContentTemplate="{DataTemplate views:ResultsPage}"
                Route="ResultsPage" />
        </Tab>

        <Tab Title="Settings" Icon="dotnet_bot.png">
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
